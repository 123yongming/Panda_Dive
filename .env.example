OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# Memory backend
MEMORY_ENABLED=false
MEMORY_BACKEND=sqlite
MEMORY_NAMESPACE_TEMPLATE=memory.owner.{owner}
MEMORY_SQLITE_PATH=.memory/memory.sqlite3
MEMORY_SQLITE_JOURNAL_MODE=WAL
MEMORY_SQLITE_BUSY_TIMEOUT_MS=5000
MEMORY_SEARCH_CANDIDATES=200
MEMORY_ANN_ENABLED=true
MEMORY_ANN_MAX_ELEMENTS=200000
MEMORY_ANN_CANDIDATES=200
MEMORY_RRF_K=60
MEMORY_RRF_CANDIDATE_MAX=400

# Memory embedding (SiliconFlow / OpenAI-compatible)
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_PROVIDER=siliconflow_openai_compatible
MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
MEMORY_EMBEDDING_API_KEY=
# Deprecated and ignored after ANN+RRF migration:
MEMORY_VECTOR_WEIGHT=0.6
